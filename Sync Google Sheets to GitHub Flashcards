Sync Google Sheets to GitHub Flashcards

on:
  schedule:
    # S'exécute automatiquement tous les jours à minuit UTC
    - cron: '0 0 * * *'
  workflow_dispatch: # Permet de cliquer sur un bouton dans GitHub pour mettre à jour instantanément

jobs:
  sync-sheets:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pandas

      - name: Fetch Google Sheets & Convert
        run: python scripts/convert.py

      - name: Commit & Push changes if updated
        uses: stefanzweifel/git-auto-commit-action@v4
        with:
          commit_message: "auto: Synchronisation automatique depuis Google Sheets"
          file_pattern: "data/* lecons/*"
